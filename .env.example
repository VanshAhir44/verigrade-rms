# Application Configuration
APP_NAME="Verified Student Result Management System"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# PostgreSQL Database
POSTGRES_USER=rms_user
POSTGRES_PASSWORD=
POSTGRES_DB=rms_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=

# JWT Authentication (set a 32+ character random string in .env)
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Seed Accounts (set passwords in .env before running python -m app.db.seed)
SEED_ADMIN_EMAIL=admin@university.edu
SEED_ADMIN_PASSWORD=
SEED_FACULTY_EMAIL=faculty@university.edu
SEED_FACULTY_PASSWORD=
SEED_STUDENT1_EMAIL=student1@university.edu
SEED_STUDENT1_PASSWORD=
SEED_STUDENT2_EMAIL=student2@university.edu
SEED_STUDENT2_PASSWORD=

# Blockchain (Phase 2: Hardhat Local / Sepolia Testnet)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_DEPLOYER_KEY=
RESULT_REGISTRY_CONTRACT_ADDRESS=

# Frontend & Public Verification (Phase 3 & 4)
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
